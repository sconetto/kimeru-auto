# ============================================
# Kimeru Auto — Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database (Supabase PostgreSQL) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kimeru-auto
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kimeru-auto

# ---------- Auth (NextAuth.js v5) ----------
AUTH_SECRET=replace-with-a-random-32-char-string
AUTH_URL=http://localhost:3000

# ---------- Admin (seeded admin account) ----------
ADMIN_EMAIL=admin@kimeru.example
ADMIN_PASSWORD=replace-with-a-strong-password

# ---------- FIPE API (fipe.parallelum.com.br) ----------
FIPE_API_BASE_URL=https://fipe.parallelum.com.br/api/v2
FIPE_API_TOKEN= # optional — increases limit from 500 to 1000 req/day

# ---------- Redis (Upstash) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- YouTube Data API (AI content pipeline) ----------
YOUTUBE_API_KEY=

# ---------- LLM (AI content pipeline) ----------
OPENAI_API_KEY= # or ANTHROPIC_API_KEY if using Claude

# ---------- Analytics / Monitoring ----------
NEXT_PUBLIC_SENTRY_DSN=
